# LifeRoute Emergency Healthcare Coordination Platform
# Environment Configuration Template

# Server Port
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liferoute

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production

# AI Engine (Groq Server-Side Integration)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google AI Vision API (Medical Image & Trauma Detection)
GOOGLE_VISION_API_KEY=
VITE_GOOGLE_VISION_API_KEY=

# Realtime & Mapping (Google Maps API)
MAPS_API_KEY=
VITE_MAPS_API_KEY=
VITE_API_BASE_URL=http://localhost:3001

# Payment Gateway (Razorpay Integration)
RAZORPAY_KEY_ID=
VITE_RAZORPAY_KEY_ID=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Secure Medical Document Storage (S3 / Cloudflare R2)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Push Notifications (Firebase Cloud Messaging / WebPush)
PUSH_NOTIFICATION_KEY=

